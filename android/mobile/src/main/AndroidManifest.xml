<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- "Tell me when a request is ready": asked for when it's useful (Settings, Requests), never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Seedy Wrapped's "Save image" on Android 9 and older (newer ones save to Pictures without it). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application>
        <!-- Seedy Wrapped's pictures, handed to the app they're shared with. -->
        <provider
            android:name="io.github.arkmind.seedy.mobile.wrapped.WrappedFiles"
            android:authorities="${applicationId}.wrapped"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/wrapped_paths" />
        </provider>
        <!-- The APK updater's new version telling it's installed (UpdatedNotice). -->
        <receiver android:name="io.github.arkmind.seedy.mobile.update.UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
