<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- "Continue watching on the Google TV home": Seedy's cards in the home screen's row (Watch Next programs). -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <application>
        <!-- Those cards' pictures, saved on the TV for the launcher (WatchNextArt): artwork only, read-only. -->
        <provider
            android:name="io.github.arkmind.seedy.tv.watchnext.WatchNextArt"
            android:authorities="${applicationId}.watchnext"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
