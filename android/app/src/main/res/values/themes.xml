<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Seedy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/seedy_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Seedy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/seedy_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Seedy</item>
    </style>
</resources>
